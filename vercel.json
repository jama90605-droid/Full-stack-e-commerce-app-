{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ecommerceproject-env.eba-kesmjpp4.eu-north-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://ecommerceproject-env.eba-kesmjpp4.eu-north-1.elasticbeanstalk.com/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
